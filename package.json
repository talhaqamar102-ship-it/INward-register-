{
  "name": "packing-mes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 test/packing-system.test.js test/http.test.js test/enterprise-gaps.test.js test/db-reliability.test.js test/order-integrity.test.js test/catalog-integration.test.js",
    "test:unit": "tsx --test src/utils/requisitionLogic.test.ts",
    "test:e2e": "playwright test",
    "verify:all": "npm run lint && npm run test:unit && npm test && npm run build && npm run test:e2e && npm run graphify",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "graphify": "tsx scripts/graphify.ts update .",
    "graphify:query": "tsx scripts/graphify.ts query"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
